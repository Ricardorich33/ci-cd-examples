pipeline {
    agent any
    environment {
        REGISTRY = 'ghcr.io'
        IMAGE = '你的用户名/app'
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build') {
            steps {
                script {
                    docker.build("${REGISTRY}/${IMAGE}:${env.BUILD_NUMBER}")
                }
            }
        }
        stage('Push') {
            steps {
                script {
                    docker.withRegistry("https://${REGISTRY}", 'registry-credentials') {
                        docker.image("${REGISTRY}/${IMAGE}:${env.BUILD_NUMBER}").push()
                    }
                }
            }
        }
        stage('Deploy') {
            steps {
                sshagent(['deploy-key']) {
                    sh "ssh -o StrictHostKeyChecking=no 用户@服务器 'cd /opt/app && docker compose up -d --build'"
                }
            }
        }
    }
}
